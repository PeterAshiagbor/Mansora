# Copy to .env (never commit real values)
DATABASE_URL=postgres://mansora:change-me@localhost:5432/mansora
PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed to call the admin API from a browser
ADMIN_ORIGINS=http://localhost:5174
# Local fallback only, used when no BACKUP_S3_* settings are supplied
BACKUP_DIR=./data/backups

# Optional: comma-separated proxy IPs/CIDRs. Leave empty for direct connections.
TRUSTED_PROXIES=

# Use this only with api:migrate; the API server never runs migrations.
# MIGRATION_DATABASE_URL=postgres://migration-user:change-me@localhost:5432/mansora

# Optional S3-compatible backup storage. Set all five via a secret manager.
# No credential values belong in this file or the dashboard configuration.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# AES256 by default; set none only if the provider does not support SSE-S3.
# BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
# Optional Prometheus endpoint. Unset => /metrics returns 404.
# Use a separate random secret of 32-256 printable ASCII characters without spaces.
METRICS_TOKEN=
# Optional HTTP(S) error receiver. Unset => no outbound error reporting.
# Use HTTPS in hosted deployments; URLs with embedded credentials are rejected.
ERROR_WEBHOOK_URL=

# Optional Resend transactional email. Keep the key private, never in frontend config.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
PLATFORM_ALERT_EMAIL=
# Comma-separated test recipient allowlist; required when enabling team-test email.
RESEND_ALLOWED_RECIPIENTS=
